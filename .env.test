# Test environment configuration
# Used by Playwright tests with mock server on fixed port 3000
VITE_GITHUB_API_URL=http://localhost:3000

# Toast duration for tests (in milliseconds) - longer to allow assertions
VITE_TOAST_DURATION=10000

# Three-layer debug logging: BROWSER (app) + TEST (playwright) + SERVER (mock server)
# Logs to /tmp/unified-debug.log with timestamps for test debugging
VITE_DEBUG_LOGGING=1
DEBUG_LOGGING=1
